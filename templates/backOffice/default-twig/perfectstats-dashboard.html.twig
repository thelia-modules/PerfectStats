<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script>
var PERFECTSTATS_URLS = {
    summary:   '{{ path('perfectstats.summary') }}',
    orders:    '{{ path('perfectstats.orders') }}',
    revenue:   '{{ path('perfectstats.revenue') }}',
