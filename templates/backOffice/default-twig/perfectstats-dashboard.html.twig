{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block body_testid %}perfectstats-dashboard{% endblock %}

{% block title %}PerfectStats{% endblock %}

{% block content %}
{% if not is_granted('VIEW', {resource: 'admin.module', module: 'PerfectStats'}) %}
    <div class="alert alert-danger">{{ 'Access denied'|trans }}</div>
{% else %}
<div class="perfectstats-dashboard">
    <div class="row">
        <div class="col-12">

            {# Mode selector bar #}
            <div class="perfectstats-mode-bar">
                <div class="period-dropdown-wrapper">
                    <div class="period-dropdown-btn" id="period-dropdown-btn">
                        <span class="period-icon bi bi-calendar3"></span>
                        <span id="period-btn-label">{{ 'perfectstats.mode.month'|trans({}, 'perfectstats.bo.default') }} — {{ current_month_name }} {{ current_year }}</span>
                        <span class="period-caret bi bi-chevron-down ms-auto"></span>
                    </div>
                    <div class="period-dropdown-menu" id="period-dropdown-menu">
                        <div class="period-option" data-mode="day">
                            <span class="period-icon bi bi-sun"></span>
                            <span class="period-title">{{ 'perfectstats.mode.day'|trans({}, 'perfectstats.bo.default') }}</span>
                        </div>
                        <div class="period-option" data-mode="week">
                            <span class="period-icon bi bi-calendar3"></span>
                            <span class="period-title">{{ 'perfectstats.mode.week'|trans({}, 'perfectstats.bo.default') }}</span>
                        </div>
                        <div class="period-option active" data-mode="month">
                            <span class="period-icon bi bi-calendar-month"></span>
                            <span class="period-title">{{ 'perfectstats.mode.month'|trans({}, 'perfectstats.bo.default') }} — {{ current_month_name }} {{ current_year }}</span>
                        </div>
                        <div class="period-option" data-mode="quarter">
                            <span class="period-icon bi bi-pie-chart"></span>
                            <span class="period-title">{{ 'perfectstats.mode.quarter'|trans({}, 'perfectstats.bo.default') }} {{ current_quarter }} — {{ current_year }}</span>
                        </div>
                        <div class="period-option" data-mode="year">
                            <span class="period-icon bi bi-graph-up"></span>
                            <span class="period-title">{{ 'perfectstats.mode.year'|trans({}, 'perfectstats.bo.default') }} {{ current_year }}</span>
                        </div>
                        <div class="period-option" data-mode="custom">
                            <span class="period-icon bi bi-sliders"></span>
                            <span class="period-title">{{ 'perfectstats.mode.custom'|trans({}, 'perfectstats.bo.default') }}</span>
                        </div>
                    </div>
                    <div class="custom-period-panel" id="custom-period-panel">
                        <div class="custom-period-row">
                            <label>{{ 'perfectstats.custom.start'|trans({}, 'perfectstats.bo.default') }}</label>
                            <input type="date" id="custom-date-start" />
                            <label>{{ 'perfectstats.custom.end'|trans({}, 'perfectstats.bo.default') }}</label>
                            <input type="date" id="custom-date-end" />
                        </div>
                        <div class="custom-period-compare">
                            <input type="checkbox" id="custom-compare" checked />
                            <label for="custom-compare">{{ 'perfectstats.custom.compare'|trans({}, 'perfectstats.bo.default') }}</label>
                        </div>
                        <div class="custom-period-compare-row" id="custom-compare-row">
                            <label>{{ 'perfectstats.custom.prev.start'|trans({}, 'perfectstats.bo.default') }}</label>
                            <input type="date" id="custom-date-prev-start" />
                            <label>{{ 'perfectstats.custom.prev.end'|trans({}, 'perfectstats.bo.default') }}</label>
                            <input type="date" id="custom-date-prev-end" />
                            <button class="btn-reset-prev" id="btn-reset-prev" title="{{ 'perfectstats.custom.prev.reset'|trans({}, 'perfectstats.bo.default') }}">↺ N-1</button>
                        </div>
                        <div class="custom-period-footer">
                            <button class="btn-apply-custom" id="btn-apply-custom">{{ 'perfectstats.custom.apply'|trans({}, 'perfectstats.bo.default') }}</button>
                        </div>
                    </div>
                </div>
                <span class="perfectstats-period-label" id="period-label">
                    {{ current_month_name }} {{ current_year }} {{ 'perfectstats.vs'|trans({}, 'perfectstats.bo.default') }} {{ previous_year }}
                </span>
            </div>

            {# KPI Summary Cards #}
            <div class="perfectstats-summary">
                <div class="row">
                    <div class="col-md-2">
                        <div class="stat-card stat-card-primary">
                            <div class="stat-label">{{ 'perfectstats.total.ca'|trans({}, 'perfectstats.bo.default') }}</div>
                            <div class="stat-value" id="stat-total-amount"><span class="loading-spinner"><i class="bi bi-arrow-repeat"></i></span></div>
                            <div class="stat-evolution" id="evolution-total-amount"></div>
                            <div class="stat-prev" id="prev-total-amount"></div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="stat-card stat-card-info">
                            <div class="stat-label">{{ 'perfectstats.total.orders'|trans({}, 'perfectstats.bo.default') }}</div>
                            <div class="stat-value" id="stat-order-count"><span class="loading-spinner"><i class="bi bi-arrow-repeat"></i></span></div>
                            <div class="stat-evolution" id="evolution-order-count"></div>
                            <div class="stat-prev" id="prev-order-count"></div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="stat-card stat-card-success">
                            <div class="stat-label">{{ 'perfectstats.orders.sent'|trans({}, 'perfectstats.bo.default') }}</div>
                            <div class="stat-value" id="stat-sent-count"><span class="loading-spinner"><i class="bi bi-arrow-repeat"></i></span></div>
                            <div class="stat-evolution" id="evolution-sent-count"></div>
                            <div class="stat-prev" id="prev-sent-count"></div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="stat-card stat-card-danger">
                            <div class="stat-label">{{ 'perfectstats.orders.cancelled'|trans({}, 'perfectstats.bo.default') }}</div>
                            <div class="stat-value" id="stat-cancelled-count"><span class="loading-spinner"><i class="bi bi-arrow-repeat"></i></span></div>
                            <div class="stat-evolution" id="evolution-cancelled-count"></div>
                            <div class="stat-prev" id="prev-cancelled-count"></div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="stat-card stat-card-warning">
                            <div class="stat-label">{{ 'perfectstats.average.order'|trans({}, 'perfectstats.bo.default') }}</div>
                            <div class="stat-value" id="stat-avg-order"><span class="loading-spinner"><i class="bi bi-arrow-repeat"></i></span></div>
                            <div class="stat-evolution" id="evolution-avg-order"></div>
                            <div class="stat-prev" id="prev-avg-order"></div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="stat-card stat-card-purple">
                            <div class="stat-label">{{ 'perfectstats.cancellation.rate'|trans({}, 'perfectstats.bo.default') }}</div>
                            <div class="stat-value" id="stat-cancel-rate"><span class="loading-spinner"><i class="bi bi-arrow-repeat"></i></span></div>
                            <div class="stat-prev" id="prev-cancel-rate"></div>
                        </div>
                    </div>
                </div>
            </div>

            {# Tabs (BS5 — data-bs-toggle/data-bs-target) #}
            <div class="perfectstats-tabs">
                <ul class="nav nav-tabs" id="perfectstatsTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="tab-orders-btn" data-bs-toggle="tab" data-bs-target="#tab-orders" type="button" role="tab">
                            <i class="bi bi-cart3"></i> {{ 'perfectstats.tab.orders'|trans({}, 'perfectstats.bo.default') }}
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-payments-btn" data-bs-toggle="tab" data-bs-target="#tab-payments" type="button" role="tab">
                            <i class="bi bi-credit-card"></i> {{ 'perfectstats.tab.payments'|trans({}, 'perfectstats.bo.default') }}
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-shipping-btn" data-bs-toggle="tab" data-bs-target="#tab-shipping" type="button" role="tab">
                            <i class="bi bi-truck"></i> {{ 'perfectstats.tab.shipping'|trans({}, 'perfectstats.bo.default') }}
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-products-btn" data-bs-toggle="tab" data-bs-target="#tab-products" type="button" role="tab">
                            <i class="bi bi-tag"></i> {{ 'perfectstats.tab.products'|trans({}, 'perfectstats.bo.default') }}
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-customers-btn" data-bs-toggle="tab" data-bs-target="#tab-customers" type="button" role="tab">
                            <i class="bi bi-people"></i> {{ 'perfectstats.tab.customers'|trans({}, 'perfectstats.bo.default') }}
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-geography-btn" data-bs-toggle="tab" data-bs-target="#tab-geography" type="button" role="tab">
                            <i class="bi bi-globe"></i> {{ 'perfectstats.tab.geography'|trans({}, 'perfectstats.bo.default') }}
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-brands-btn" data-bs-toggle="tab" data-bs-target="#tab-brands" type="button" role="tab">
                            <i class="bi bi-bookmark"></i> {{ 'perfectstats.tab.brands'|trans({}, 'perfectstats.bo.default') }}
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-coupons-btn" data-bs-toggle="tab" data-bs-target="#tab-coupons" type="button" role="tab">
                            <i class="bi bi-percent"></i> {{ 'perfectstats.tab.coupons'|trans({}, 'perfectstats.bo.default') }}
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="perfectstatsTabContent">
                    {# Orders Tab #}
                    <div role="tabpanel" class="tab-pane fade show active" id="tab-orders">
                        <div class="perfectstats-chart-container">
                            <div class="granularity-bar" id="granularity-bar">
                                <label>{{ 'perfectstats.granularity.label'|trans({}, 'perfectstats.bo.default') }}</label>
                                <div class="btn-group">
                                    <button class="btn btn-outline-secondary btn-sm" data-gran="day">{{ 'perfectstats.granularity.day'|trans({}, 'perfectstats.bo.default') }}</button>
                                    <button class="btn btn-outline-secondary btn-sm active" data-gran="month">{{ 'perfectstats.granularity.month'|trans({}, 'perfectstats.bo.default') }}</button>
                                    <button class="btn btn-outline-secondary btn-sm" data-gran="quarter">{{ 'perfectstats.granularity.quarter'|trans({}, 'perfectstats.bo.default') }}</button>
                                    <button class="btn btn-outline-secondary btn-sm" data-gran="year">{{ 'perfectstats.granularity.year'|trans({}, 'perfectstats.bo.default') }}</button>
                                </div>
                            </div>
                            <h3 id="orders-chart-title">{{ 'perfectstats.orders.by.status'|trans({}, 'perfectstats.bo.default') }}</h3>
                            <div class="chart-wrapper">
                                <canvas id="ordersChart"></canvas>
                            </div>
                            <h3 id="revenue-chart-title" style="margin-top:30px">{{ 'perfectstats.orders.monthly.revenue'|trans({}, 'perfectstats.bo.default') }}</h3>
                            <div class="chart-wrapper">
                                <canvas id="revenueChart"></canvas>
                            </div>
                        </div>
                    </div>

                    {# Payments Tab #}
                    <div role="tabpanel" class="tab-pane fade" id="tab-payments">
                        <div class="perfectstats-chart-container">
                            <h3>{{ 'perfectstats.payments.methods'|trans({}, 'perfectstats.bo.default') }}</h3>
                            <div class="chart-row">
                                <div class="chart-col">
                                    <h4 class="text-center" id="payments-chart-current-title"></h4>
                                    <div class="chart-wrapper">
                                        <canvas id="paymentsChartCurrent"></canvas>
                                    </div>
                                </div>
                                <div class="chart-col">
                                    <h4 class="text-center compare-hide" id="payments-chart-previous-title"></h4>
                                    <div class="chart-wrapper compare-hide">
                                        <canvas id="paymentsChartPrevious"></canvas>
                                    </div>
                                </div>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-striped table-hover" id="payments-table">
                                    <thead>
                                        <tr>
                                            <th>{{ 'perfectstats.method'|trans({}, 'perfectstats.bo.default') }}</th>
                                            <th id="payments-th-current"></th>
                                            <th id="payments-th-previous" class="compare-hide"></th>
                                            <th class="compare-hide">{{ 'perfectstats.evolution'|trans({}, 'perfectstats.bo.default') }}</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    {# Shipping Tab #}
                    <div role="tabpanel" class="tab-pane fade" id="tab-shipping">
                        <div class="perfectstats-chart-container">
                            <h3>{{ 'perfectstats.shipping.methods'|trans({}, 'perfectstats.bo.default') }}</h3>
                            <div class="chart-row">
                                <div class="chart-col">
                                    <h4 class="text-center" id="shipping-chart-current-title"></h4>
                                    <div class="chart-wrapper">
                                        <canvas id="shippingChartCurrent"></canvas>
                                    </div>
                                </div>
                                <div class="chart-col">
                                    <h4 class="text-center compare-hide" id="shipping-chart-previous-title"></h4>
                                    <div class="chart-wrapper compare-hide">
                                        <canvas id="shippingChartPrevious"></canvas>
                                    </div>
                                </div>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-striped table-hover" id="shipping-table">
                                    <thead>
                                        <tr>
                                            <th>{{ 'perfectstats.method'|trans({}, 'perfectstats.bo.default') }}</th>
                                            <th id="shipping-th-current"></th>
                                            <th id="shipping-th-previous" class="compare-hide"></th>
                                            <th class="compare-hide">{{ 'perfectstats.evolution'|trans({}, 'perfectstats.bo.default') }}</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    {# Products Tab #}
                    <div role="tabpanel" class="tab-pane fade" id="tab-products">
                        <div class="perfectstats-chart-container">
                            <div class="chart-row">
                                <div class="chart-col">
                                    <h3 id="products-current-title"></h3>
                                    <div class="table-responsive">
                                        <table class="table table-striped table-hover" id="products-table">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th>{{ 'perfectstats.product'|trans({}, 'perfectstats.bo.default') }}</th>
                                                    <th>{{ 'perfectstats.quantity'|trans({}, 'perfectstats.bo.default') }}</th>
                                                    <th>{{ 'perfectstats.amount'|trans({}, 'perfectstats.bo.default') }}</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="chart-col">
                                    <h3 id="products-previous-title" class="compare-hide"></h3>
                                    <div class="table-responsive compare-hide">
                                        <table class="table table-striped table-hover" id="products-prev-table">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th>{{ 'perfectstats.product'|trans({}, 'perfectstats.bo.default') }}</th>
                                                    <th>{{ 'perfectstats.quantity'|trans({}, 'perfectstats.bo.default') }}</th>
                                                    <th>{{ 'perfectstats.amount'|trans({}, 'perfectstats.bo.default') }}</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <h3>{{ 'perfectstats.products.best'|trans({}, 'perfectstats.bo.default') }} — {{ 'perfectstats.n.year'|trans({}, 'perfectstats.bo.default') }} {{ 'perfectstats.vs'|trans({}, 'perfectstats.bo.default') }} {{ 'perfectstats.n1.year'|trans({}, 'perfectstats.bo.default') }}</h3>
                            <div class="chart-wrapper">
                                <canvas id="productsChart"></canvas>
                            </div>
                        </div>
                    </div>

                    {# Customers Tab #}
                    <div role="tabpanel" class="tab-pane fade" id="tab-customers">
                        <div class="perfectstats-chart-container">
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="stat-card stat-card-info">
                                        <div class="stat-label">{{ 'perfectstats.customers.new'|trans({}, 'perfectstats.bo.default') }}</div>
                                        <div class="stat-value" id="stat-new-customers">--</div>
                                        <div class="stat-evolution" id="evolution-new-customers"></div>
                                        <div class="stat-prev" id="prev-new-customers"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="chart-row">
                                <div class="chart-col">
                                    <h3 id="customers-current-title"></h3>
                                    <div class="table-responsive">
                                        <table class="table table-striped table-hover" id="customers-table">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th>{{ 'perfectstats.customer'|trans({}, 'perfectstats.bo.default') }}</th>
                                                    <th>{{ 'perfectstats.orders.count'|trans({}, 'perfectstats.bo.default') }}</th>
                                                    <th>{{ 'perfectstats.total.spent'|trans({}, 'perfectstats.bo.default') }}</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="chart-col">
                                    <h3 id="customers-previous-title" class="compare-hide"></h3>
                                    <div class="table-responsive compare-hide">
                                        <table class="table table-striped table-hover" id="customers-prev-table">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th>{{ 'perfectstats.customer'|trans({}, 'perfectstats.bo.default') }}</th>
                                                    <th>{{ 'perfectstats.orders.count'|trans({}, 'perfectstats.bo.default') }}</th>
                                                    <th>{{ 'perfectstats.total.spent'|trans({}, 'perfectstats.bo.default') }}</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Geography Tab #}
                    <div role="tabpanel" class="tab-pane fade" id="tab-geography">
                        <div class="perfectstats-chart-container">
                            <h3>{{ 'perfectstats.geography.title'|trans({}, 'perfectstats.bo.default') }}</h3>
                            <div class="chart-row">
                                <div class="chart-col">
                                    <h4 class="text-center" id="geo-chart-current-title"></h4>
                                    <div class="chart-wrapper">
                                        <canvas id="geoChartCurrent"></canvas>
                                    </div>
                                </div>
                                <div class="chart-col">
                                    <h4 class="text-center compare-hide" id="geo-chart-previous-title"></h4>
                                    <div class="chart-wrapper compare-hide">
                                        <canvas id="geoChartPrevious"></canvas>
                                    </div>
                                </div>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-striped table-hover" id="country-table">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>{{ 'perfectstats.country'|trans({}, 'perfectstats.bo.default') }}</th>
                                            <th id="geo-th-current"></th>
                                            <th id="geo-th-previous" class="compare-hide"></th>
                                            <th class="compare-hide">{{ 'perfectstats.evolution'|trans({}, 'perfectstats.bo.default') }}</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    {# Brands Tab #}
                    <div role="tabpanel" class="tab-pane fade" id="tab-brands">
                        <div class="perfectstats-chart-container">
                            <h3>{{ 'perfectstats.brands.title'|trans({}, 'perfectstats.bo.default') }}</h3>
                            <div class="chart-row">
                                <div class="chart-col">
                                    <h4 class="text-center" id="brands-current-title"></h4>
                                    <div class="table-responsive">
                                        <table class="table table-striped table-hover" id="brands-table">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th>{{ 'perfectstats.brand'|trans({}, 'perfectstats.bo.default') }}</th>
                                                    <th>{{ 'perfectstats.quantity'|trans({}, 'perfectstats.bo.default') }}</th>
                                                    <th>{{ 'perfectstats.amount'|trans({}, 'perfectstats.bo.default') }}</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="chart-col">
                                    <h4 class="text-center compare-hide" id="brands-previous-title"></h4>
                                    <div class="table-responsive compare-hide">
                                        <table class="table table-striped table-hover" id="brands-prev-table">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th>{{ 'perfectstats.brand'|trans({}, 'perfectstats.bo.default') }}</th>
                                                    <th>{{ 'perfectstats.quantity'|trans({}, 'perfectstats.bo.default') }}</th>
                                                    <th>{{ 'perfectstats.amount'|trans({}, 'perfectstats.bo.default') }}</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <h3 style="margin-top:20px">{{ 'perfectstats.brands.best'|trans({}, 'perfectstats.bo.default') }} — {{ 'perfectstats.n.year'|trans({}, 'perfectstats.bo.default') }} {{ 'perfectstats.vs'|trans({}, 'perfectstats.bo.default') }} {{ 'perfectstats.n1.year'|trans({}, 'perfectstats.bo.default') }}</h3>
                            <div class="chart-wrapper">
                                <canvas id="brandsChart"></canvas>
                            </div>
                        </div>
                    </div>

                    {# Coupons Tab #}
                    <div role="tabpanel" class="tab-pane fade" id="tab-coupons">
                        <div class="perfectstats-chart-container">
                            <h3>{{ 'perfectstats.coupons.title'|trans({}, 'perfectstats.bo.default') }}</h3>
                            <div class="chart-row">
                                <div class="chart-col">
                                    <h4 class="text-center" id="coupons-current-title"></h4>
                                    <div class="table-responsive">
                                        <table class="table table-striped table-hover" id="coupons-table">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th>{{ 'perfectstats.coupon.code'|trans({}, 'perfectstats.bo.default') }}</th>
                                                    <th>{{ 'perfectstats.coupon.usages'|trans({}, 'perfectstats.bo.default') }}</th>
                                                    <th>{{ 'perfectstats.coupon.discount'|trans({}, 'perfectstats.bo.default') }}</th>
                                                    <th>{{ 'perfectstats.coupon.orders'|trans({}, 'perfectstats.bo.default') }}</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                                <div class="chart-col">
                                    <h4 class="text-center compare-hide" id="coupons-previous-title"></h4>
                                    <div class="table-responsive compare-hide">
                                        <table class="table table-striped table-hover" id="coupons-prev-table">
                                            <thead>
                                                <tr>
                                                    <th>#</th>
                                                    <th>{{ 'perfectstats.coupon.code'|trans({}, 'perfectstats.bo.default') }}</th>
                                                    <th>{{ 'perfectstats.coupon.usages'|trans({}, 'perfectstats.bo.default') }}</th>
                                                    <th>{{ 'perfectstats.coupon.discount'|trans({}, 'perfectstats.bo.default') }}</th>
                                                    <th>{{ 'perfectstats.coupon.orders'|trans({}, 'perfectstats.bo.default') }}</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>{# /tab-content #}
            </div>{# /perfectstats-tabs #}

        </div>
    </div>
</div>
{% endif %}
