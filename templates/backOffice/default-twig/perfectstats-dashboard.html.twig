    coupons:   '{{ path('perfectstats.coupons') }}'
};
var PERFECTSTATS_YEARS = {
    current:          {{ current_year }},
    previous:         {{ previous_year }},
    currentMonth:     {{ current_month }},
    currentMonthName: '{{ current_month_name }}',
    currentWeek:      {{ current_week }},
    currentQuarter:   {{ current_quarter }}
};
var PERFECTSTATS_LABELS = {
    sent:         '{{ 'perfectstats.orders.sent'|trans({}, 'perfectstats.bo.default')|e('js') }}',
    cancelled:    '{{ 'perfectstats.orders.cancelled'|trans({}, 'perfectstats.bo.default')|e('js') }}',
    noData:       '{{ 'perfectstats.no.data'|trans({}, 'perfectstats.bo.default')|e('js') }}',
    year:         '{{ 'perfectstats.mode.year'|trans({}, 'perfectstats.bo.default')|e('js') }}',
    month:        '{{ 'perfectstats.mode.month'|trans({}, 'perfectstats.bo.default')|e('js') }}',
    week:         '{{ 'perfectstats.mode.week'|trans({}, 'perfectstats.bo.default')|e('js') }}',
    day:          '{{ 'perfectstats.mode.day'|trans({}, 'perfectstats.bo.default')|e('js') }}',
    quarter:      '{{ 'perfectstats.mode.quarter'|trans({}, 'perfectstats.bo.default')|e('js') }}',
    periodYear:   '{{ 'perfectstats.period.year'|trans({}, 'perfectstats.bo.default')|e('js') }}',
    periodMonth:  '{{ 'perfectstats.period.month'|trans({}, 'perfectstats.bo.default')|e('js') }}',
    periodWeek:   '{{ 'perfectstats.period.week'|trans({}, 'perfectstats.bo.default')|e('js') }}',
    periodDay:    '{{ 'perfectstats.period.day'|trans({}, 'perfectstats.bo.default')|e('js') }}',
    periodQuarter:'{{ 'perfectstats.period.quarter'|trans({}, 'perfectstats.bo.default')|e('js') }}',
    periodCustom: '{{ 'perfectstats.period.custom'|trans({}, 'perfectstats.bo.default')|e('js') }}',
    customMode:   '{{ 'perfectstats.mode.custom'|trans({}, 'perfectstats.bo.default')|e('js') }}',
